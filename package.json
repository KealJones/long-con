{
  "name": "long-con",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "evals"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "cli": "node --experimental-strip-types apps/cli/src/main.ts",
    "typecheck": "tsc",
    "test": "node --experimental-strip-types --no-warnings --test packages/*/test/*.test.ts evals/test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "^5.9.3"
  }
}
